# ==============================================================================
# YasIX Store — Environment Configuration Template
# Copy this file to .env and adjust variables to match your local environment.
# ==============================================================================

# Application Settings
APP_NAME="YasIX Store"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Relational Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yasix_store
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Cryptographic Token Security
SESSION_LIFETIME=7200
CSRF_SECRET=cyber_yasix_secret_key_change_in_production
